{
  "name": "@vibearound/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "bun build --compile --no-compile-autoload-bunfig src/main.ts --outfile dist/va-agent && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.20",
    "typescript": "5.9.3"
  }
}
