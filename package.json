{
  "name": "@vibearound/agent",
  "version": "0.1.2",
  "description": "VibeAround Agent — the built-in ACP coding agent for VibeAround",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazzenchen/va-agent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "va-agent": "dist/va-agent.js"
  },
  "files": [
    "dist/va-agent.js",
    "dist/photon_rs_bg.wasm"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "build": "node scripts/build-npm.mjs",
    "build:binary": "bun build --compile --no-compile-autoload-bunfig src/main.ts --outfile dist/va-agent && node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "22.19.20",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
